{
  "name": "city-view",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --filter @pinny/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "data:sp": "python data/build_sp.py",
    "demo": "pnpm --filter @pinny/embed-demo dev",
    "tiles": "cargo run --release -p tiler -- data/out/empresas.parquet data/out/empresas data/specs/empresas.json",
    "synth": "cargo run --release -p synth -- --rows 30000000 --out data/out/empresas.parquet",
    "datapacks": "python datapacks/build.py",
    "api": "cargo run --release -p pinny-api",
    "library": "python datapacks/library/build.py",
    "assets": "python data/fetch_assets.py",
    "places": "python data/build_places.py",
    "cidades": "python data/build_cidades.py",
    "wasm": "node tooling/build-wasm.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "sirv": "^3.0.2",
    "vite": "^8.3.4"
  }
}
